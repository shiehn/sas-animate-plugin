{
  "name": "@signalsandsorcery/animate",
  "version": "1.0.0",
  "description": "Animation control panel — a menu of musical automations (pump, autopan, trance gate, fades, DJ filter sweeps, duck/sidechain-filter and other listen-driven moves) applied to any tracks in the scene via declarative, render-parity-safe engine configs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./plugin.json": "./plugin.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@signalsandsorcery/plugin-sdk": "file:../sas-plugin-sdk",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@signalsandsorcery/plugin-sdk": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT"
}
